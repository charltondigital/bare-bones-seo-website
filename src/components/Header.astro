---
import Skull from './Skull.astro';
import { site } from '../data/site.js';
---
<header class="wrap">
  <a class="mark" href="/" aria-label={`${site.name} home`}>
    <span class="brand-skull"><Skull size={26} /></span>
    <span>{site.name}</span>
  </a>
  <nav aria-label="Main">
    <a href="/">Home</a>
    <a href="/wordpress/">WordPress</a>
    <a href="/ai-sites/">AI sites</a>
  </nav>
</header>

<style>
  header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1.25rem; margin-bottom: clamp(1.25rem, 2.5vw, 2rem); border-bottom: 1px solid var(--line); }
  .mark { display: inline-flex; align-items: center; gap: .65rem; text-decoration: none; font-family: var(--sans); font-weight: 800; font-size: 1.05rem; letter-spacing: -.035em; transition: color .15s; }
  .mark:hover, .mark:focus-visible { color: var(--plate); }
  .brand-skull{display:inline-grid;place-items:center;width:2.1rem;height:2.1rem;flex:none;background:#e8edf3;color:#172233;border-radius:50%;transition:background-color .15s, color .15s; }
  .mark:hover .brand-skull, .mark:focus-visible .brand-skull { background: var(--plate); color: #172233; }
  .brand-skull :global(svg){width:1.18rem;height:1.42rem}
  nav { display: flex; flex-wrap: nowrap; gap: clamp(.6rem, 1.8vw, 1.25rem); align-items: center; }
  nav a { display: inline-block; font-size: .85rem; line-height: 1.4; white-space: nowrap; text-decoration: none; font-weight: 650; color: var(--ink-soft); padding: .4rem 0; transition: color .15s; }
  nav a:hover, nav a:focus-visible { color: var(--plate); }
  @media(max-width: 35rem) {
    header { flex-wrap: wrap; row-gap: .65rem; }
    nav { width: 100%; gap: 1.2rem; }
    .mark { font-size: 1rem; }
  }
</style>
