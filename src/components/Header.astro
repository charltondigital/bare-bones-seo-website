---
import Skull from './Skull.astro';
import { site } from '../data/site.js';
---
<header class="wrap">
  <a class="mark" href="/" aria-label={`${site.name} home`}>
    <span class="brand-skull"><Skull size={26} /></span>
    <span>{site.name}</span>
  </a>
  <nav aria-label="Main">
    <a href="/">Home</a>
    <a href="/wordpress/">WordPress</a>
    <a href="/ai-sites/">AI sites</a>
  </nav>
</header>

<style>
  header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1.25rem; margin-bottom: clamp(1.25rem, 2.5vw, 2rem); border-bottom: 1px solid var(--line); }
  .mark { display: inline-flex; align-items: center; gap: .65rem; text-decoration: none; font-family: var(--sans); font-weight: 800; font-size: 1.05rem; letter-spacing: -.035em; transition: color .15s; }
  .mark:hover, .mark:focus-visible { color: var(--plate); }
  .brand-skull{display:inline-grid;place-items:center;width:2.1rem;height:2.1rem;flex:none;background:#e8edf3;color:#172233;border-radius:50%;transition:color .15s
  .mark:hover .brand-skull, .mark:focus-visible .brand-skull { color: var(--plate); }
  .brand-skull :global(svg){width:1.18rem;height:1.42rem}
  nav { display: flex; flex-wrap: wrap; gap: .5rem .75rem; align-items: center; }
  nav a { font-size: .85rem; white-space: nowrap; text-decoration: none; font-weight: 650; color: var(--ink-soft); padding: .5rem .8rem; border-radius: 6px; transition: background-color .15s, color .15s; }
  nav a:hover { background: var(--surface-strong); color: var(--ink); }
  @media(max-width: 27rem) { .mark { font-size: 1rem; } nav { gap: .5rem; } nav a { font-size: .83rem; } }
</style>
