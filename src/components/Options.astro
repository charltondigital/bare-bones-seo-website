---
---
<section class="section products-section" aria-labelledby="products-heading">
  <div class="wrap">
    <div class="section-intro">
      <h2 id="products-heading">Choose your SEO tool</h2>
      <p>Two free, open-source products built for different website platforms.</p>
    </div>
    <div class="products">
      <article class="product">
        <div class="product-top"><span class="product-icon ai-icon" aria-hidden="true">⌘</span><span class="product-tag">AI &amp; STATIC SITES</span></div>
        <h3>Bare Bones SEO for AI Sites</h3>
        <p class="product-subtitle">SEO control for AI-built websites</p>
        <p class="description">Your coding agent becomes your SEO dashboard. Inspect published metadata, manage indexing and schema, and verify that changes actually reach the site.</p>
        <ul><li>Conversational SEO settings</li><li>Indexation and metadata controls</li><li>Output verification, not guesswork</li></ul>
        <div class="product-footer"><span>Free · Open source</span><a class="product-button" href="/ai-sites/">Explore AI Sites <span aria-hidden="true">→</span></a></div>
      </article>
      <article class="product">
        <div class="product-top"><span class="product-icon wp-icon" aria-hidden="true">W</span><span class="product-tag">WORDPRESS</span></div>
        <h3>Bare Bones SEO for WordPress</h3>
        <p class="product-subtitle">A lightweight WordPress SEO plugin</p>
        <p class="description">Manage the technical essentials without bloat, subscriptions, or front-end assets. Edit metadata in bulk, handle redirects, and monitor 404s.</p>
        <ul><li>Bulk title and description editor</li><li>Centralized indexation controls</li><li>Redirects and 404 monitoring</li></ul>
        <div class="product-footer"><span>Free · Open source</span><a class="product-button" href="/wordpress/">Explore WordPress <span aria-hidden="true">→</span></a></div>
      </article>
    </div>
  </div>
</section>
<style>
  .section-intro{margin-bottom:2rem;max-width:38rem}
  .section-intro h2{font-size:clamp(1.7rem,2.7vw,2.3rem)}
  .section-intro p{margin-top:.65rem;color:var(--ink-soft)}
  .products{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem}
  .product{display:flex;flex-direction:column;align-items:stretch;min-width:0;padding:clamp(1.5rem,3vw,2.25rem);background:var(--surface);border:1px solid var(--line);border-radius:14px}
  .product-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1.6rem}
  .product-icon{display:grid;place-items:center;width:3.6rem;height:3.6rem;border-radius:12px;font-weight:800;font-size:1.65rem}
  .ai-icon{background:#354b65;color:var(--plate)}
  .wp-icon{background:#20496a;color:#fff;font-family:Georgia,serif;border:2px solid #719ebd;border-radius:50%}
  .product-tag{font-size:.69rem;letter-spacing:.11em;font-weight:800;color:#e5c77d}
  h3{font-size:clamp(1.45rem,2.3vw,1.9rem);max-width:23ch}
  .product-subtitle{margin-top:.65rem;font-weight:700;color:var(--ink)}
  .description{margin-top:1rem;color:var(--ink-soft)}
  ul{margin:1.4rem 0 2rem;padding-left:1.2rem;color:var(--ink-soft);font-size:.91rem;line-height:1.9}
  li::marker{color:var(--plate)}
  .product-footer{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-top:auto;padding-top:1.3rem;border-top:1px solid var(--line)}
  .product-footer>span{font-size:.79rem;color:var(--ink-soft)}
  .product-button{display:inline-flex;align-items:center;gap:1rem;justify-content:center;padding:.75rem 1rem;border:1px solid var(--plate);border-radius:7px;background:var(--plate);color:#111827;text-decoration:none;font-weight:760;font-size:.87rem}
  .product-button:hover{background:#ffe29b;color:#111827;border-color:#ffe29b}
  @media(max-width:48rem){.products{grid-template-columns:1fr}}
</style>