---
const prompts = [
  'Show me all the page metas for the services pages.',
  'Which pages are noindexed or excluded from the sitemap?',
  'Update the dermatology meta description and verify it.',
  'Check the site for conflicting canonical URLs.',
  'Verify that my SEO settings match the generated HTML.'
];
const scrollingPrompts = [...prompts, ...prompts.slice(0, 2)];
---
<div class="seo-requests" aria-label="Example requests for your existing AI coding agent">
  <div class="demo-header"><span class="demo-indicator" aria-hidden="true"></span><span class="requests-heading">AI conversation · Example prompts</span><span class="demo-label">DEMO</span></div>
  <div class="requests-viewport">
    <ul class="requests-track">
      {scrollingPrompts.map((prompt, i) => (
        <li class="request" aria-hidden={i >= prompts.length ? 'true' : undefined}>
          “{prompt}”
        </li>
      ))}
    </ul>
  </div>
</div>
<style>
  .seo-requests{min-width:0;padding:1.1rem 1.3rem 1.35rem;background:#101b2b;border:1px solid #485b73;border-radius:12px;box-shadow:0 14px 35px #0002}
  .demo-header{display:flex;align-items:center;gap:.6rem;padding-bottom:.85rem;border-bottom:1px solid #34475d}
  .demo-indicator{height:.5rem;width:.5rem;flex:none;background:var(--plate);border-radius:50%}
  .demo-label{margin-left:auto;font:.65rem/1 var(--mono);letter-spacing:.08em;color:#aebed3;border:1px solid #4b6079;border-radius:4px;padding:.3rem .4rem}
  .requests-heading{color:#c4d1e3;font:.76rem/1.45 var(--mono);font-weight:600}
  .requests-viewport{--row-height:7.5rem;height:calc(var(--row-height)*2);overflow:hidden;mask-image:linear-gradient(to bottom,transparent,#000 12%,#000 88%,transparent);-webkit-mask-image:linear-gradient(to bottom,transparent,#000 12%,#000 88%,transparent)}
  .requests-track{list-style:none;padding:0;margin:0;animation:requests-rise 22s linear infinite;will-change:transform}
  .request{height:var(--row-height);display:flex;align-items:center;padding:1.2rem .65rem 1.2rem 0;color:var(--ink);font:500 clamp(.94rem,1.55vw,1.1rem)/1.6 var(--mono);letter-spacing:-.015em}
  .seo-requests:hover .requests-track{animation-play-state:paused}
  @keyframes requests-rise{
    0%,5%{transform:translateY(0)}
    10%,25%{transform:translateY(calc(var(--row-height)*-1))}
    30%,45%{transform:translateY(calc(var(--row-height)*-2))}
    50%,65%{transform:translateY(calc(var(--row-height)*-3))}
    70%,85%{transform:translateY(calc(var(--row-height)*-4))}
    100%{transform:translateY(calc(var(--row-height)*-5))}
  }
  @media(max-width:36rem){.requests-viewport{--row-height:8rem}.request{font-size:.92rem}.seo-requests{padding:1rem}}
  @media(prefers-reduced-motion:reduce){
    .requests-viewport{height:auto;overflow:visible;mask-image:none;-webkit-mask-image:none}
    .requests-track{animation:none;will-change:auto}
    .request{height:auto;min-height:5rem;padding-block:.7rem}
    .request[aria-hidden="true"]{display:none}
  }
</style>
