---
const prompts = [
  'Show me all the page metas for the services pages.',
  'Which pages are noindexed or excluded from the sitemap?',
  'Update the dermatology meta description and verify it.',
  'Check the site for conflicting canonical URLs.',
  'Verify that my SEO settings match the generated HTML.'
];
const scrollingPrompts = [...prompts, ...prompts.slice(0, 3)];
---
<div class="seo-requests" aria-label="Examples of requests for your existing AI coding agent">
  <p class="requests-heading">Things you can ask your AI</p>
  <div class="requests-viewport">
    <ol class="requests-track">
      {scrollingPrompts.map((prompt, i) => (
        <li class="request" aria-hidden={i >= prompts.length ? 'true' : undefined}>
          <span class="request-number" aria-hidden="true">{String(i % prompts.length + 1).padStart(2, '0')}</span>
          <span class="request-text">“{prompt}”</span>
        </li>
      ))}
    </ol>
  </div>
  <p class="requests-note">Use your existing AI coding agent. No additional agent or dashboard.</p>
</div>
<style>
  .seo-requests{min-width:0;max-width:100%;padding:1rem 0}
  .requests-heading{font-size:.84rem;font-weight:700;color:var(--plate);letter-spacing:.015em;margin-bottom:.8rem}
  .requests-viewport{--row-height:6.25rem;height:calc(var(--row-height)*3);overflow:hidden;-webkit-mask-image:linear-gradient(to bottom,transparent 0%,#000 17%,#000 83%,transparent 100%);mask-image:linear-gradient(to bottom,transparent 0%,#000 17%,#000 83%,transparent 100%)}
  .requests-track{list-style:none;margin:0;padding:0;animation:requests-rise 27s linear infinite;will-change:transform}
  .request{min-height:var(--row-height);height:var(--row-height);display:grid;grid-template-columns:2.25rem minmax(0,1fr);align-items:center;gap:.8rem;border-bottom:1px solid var(--line);padding:.75rem .35rem .75rem 0}
  .request-number{font:500 .76rem var(--mono);color:var(--plate)}
  .request-text{font-size:clamp(.99rem,1.7vw,1.2rem);line-height:1.45;font-weight:560;letter-spacing:-.015em;color:var(--ink)}
  .requests-note{font-size:.82rem;line-height:1.6;color:var(--ink-soft);margin-top:1.1rem}
  .seo-requests:hover .requests-track,.seo-requests:focus-within .requests-track{animation-play-state:paused}
  @keyframes requests-rise{
    0%,15%{transform:translateY(0)}
    20%,35%{transform:translateY(calc(var(--row-height)*-1))}
    40%,55%{transform:translateY(calc(var(--row-height)*-2))}
    60%,75%{transform:translateY(calc(var(--row-height)*-3))}
    80%,95%{transform:translateY(calc(var(--row-height)*-4))}
    100%{transform:translateY(calc(var(--row-height)*-5))}
  }
  @media(max-width:36rem){.requests-viewport{--row-height:7.25rem}.request-text{font-size:1rem}}
  @media(prefers-reduced-motion:reduce){
    .requests-viewport{height:auto;overflow:visible;-webkit-mask-image:none;mask-image:none}
    .requests-track{animation:none;will-change:auto}
    .request{height:auto;min-height:4.5rem}
    .request[aria-hidden="true"]{display:none}
  }
</style>
