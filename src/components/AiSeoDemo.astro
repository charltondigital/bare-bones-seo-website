---
const prompts = [
  'Show me all the page metas for the services pages.',
  'Which pages are noindexed or excluded from the sitemap?',
  'Update the dermatology meta description and verify it.',
  'Check the site for conflicting canonical URLs.',
  'Verify that my SEO settings match the generated HTML.'
];
---
<div class="ai-demo" data-ai-demo aria-label="Example prompts for your existing AI coding agent">
  <div class="demo-top"><span class="prompt-chevron" aria-hidden="true">›</span><strong>Ask your existing AI coding agent</strong></div>
  <div class="demo-content">
    <p class="prompt"><span data-prompt>{prompts[0]}</span><span class="cursor" aria-hidden="true"></span></p>
  </div>
  <div class="demo-controls">
    <span data-counter>1 / {prompts.length}</span>
    <button type="button" data-pause>Pause</button>
    <button type="button" data-prev aria-label="Previous prompt">←</button>
    <button type="button" data-next aria-label="Next prompt">→</button>
  </div>
  <p class="demo-note">Works with your existing AI coding tools. No additional agent required.</p>
</div>
<script define:vars={{ prompts }}>
  const demo = document.querySelector('[data-ai-demo]');
  if (demo) {
    const prompt = demo.querySelector('[data-prompt]');
    const counter = demo.querySelector('[data-counter]');
    const pauseButton = demo.querySelector('[data-pause]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let paused = reduceMotion;
    let cycleTimer;
    let typeTimer;
    const clearTyping = () => clearInterval(typeTimer);
    function display(i) {
      clearTyping();
      index = (i + prompts.length) % prompts.length;
      counter.textContent = `${index + 1} / ${prompts.length}`;
      if (reduceMotion) {
        prompt.textContent = prompts[index];
        return;
      }
      prompt.textContent = '';
      let count = 0;
      typeTimer = setInterval(() => {
        count = Math.min(count + 2, prompts[index].length);
        prompt.textContent = prompts[index].slice(0, count);
        if (count === prompts[index].length) clearTyping();
      }, 35);
    }
    function schedule() {
      clearInterval(cycleTimer);
      if (!paused && !document.hidden) cycleTimer = setInterval(() => display(index + 1), 6200);
    }
    pauseButton.addEventListener('click', () => {
      paused = !paused;
      pauseButton.textContent = paused ? 'Play' : 'Pause';
      schedule();
    });
    demo.querySelector('[data-prev]').addEventListener('click', () => { display(index - 1); schedule(); });
    demo.querySelector('[data-next]').addEventListener('click', () => { display(index + 1); schedule(); });
    document.addEventListener('visibilitychange', schedule);
    demo.addEventListener('mouseenter', () => clearInterval(cycleTimer));
    demo.addEventListener('mouseleave', schedule);
    demo.addEventListener('focusin', () => clearInterval(cycleTimer));
    demo.addEventListener('focusout', e => { if (!demo.contains(e.relatedTarget)) schedule(); });
    display(0);
    if (reduceMotion) pauseButton.textContent = 'Play';
    else schedule();
  }
</script>
<style>
  .ai-demo{min-width:0;background:var(--surface);border:1px solid var(--line);border-radius:10px;overflow:hidden}
  .demo-top{display:flex;align-items:center;gap:.65rem;padding:.85rem 1rem;background:var(--surface-strong);border-bottom:1px solid var(--line);font-size:.83rem}
  .prompt-chevron{color:var(--plate);font-size:1.5rem;line-height:1;font-weight:500}
  .demo-content{display:flex;align-items:center;padding:1.5rem 1rem;min-height:12rem}
  .prompt{width:100%;padding:1.2rem;border:1px solid var(--line);border-radius:7px;background:#111a27;font-size:1rem;line-height:1.6;font-weight:600;min-height:7.5rem}
  .cursor{display:inline-block;height:1em;width:2px;background:var(--plate);margin-left:2px;vertical-align:-.16em;animation:blink 1s steps(1) infinite}
  .demo-controls{display:flex;align-items:center;gap:.6rem;padding:.7rem 1rem;border-top:1px solid var(--line);font-size:.8rem}
  .demo-controls span:first-child{margin-right:auto;color:var(--ink-soft)}
  .demo-controls button{background:var(--surface-strong);border:1px solid var(--line);border-radius:5px;color:var(--ink);padding:.35rem .7rem;cursor:pointer;font-size:.8rem}
  .demo-controls button:hover{border-color:var(--plate);color:var(--plate)}
  .demo-note{font-size:.78rem;line-height:1.5;color:var(--ink-soft);padding:0 1rem 1rem}
  @keyframes blink{50%{opacity:0}}
  @media(prefers-reduced-motion:reduce){.cursor{animation:none;display:none}}
</style>
