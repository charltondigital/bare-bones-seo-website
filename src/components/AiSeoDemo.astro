---
const prompts = [
  'Show me all the page metas for the services pages.',
  'Which pages are noindexed or excluded from the sitemap?',
  'Update the dermatology meta description and verify it.',
  'Check the site for conflicting canonical URLs.',
  'Verify that my SEO settings match the generated HTML.'
];
const scrollingPrompts = [...prompts, ...prompts.slice(0, 2)];
---
<div class="seo-requests" aria-label="Example requests for your existing AI coding agent">
  <p class="requests-heading">Ask your AI</p>
  <div class="requests-viewport">
    <ul class="requests-track">
      {scrollingPrompts.map((prompt, i) => (
        <li class="request" aria-hidden={i >= prompts.length ? 'true' : undefined}>
          “{prompt}”
        </li>
      ))}
    </ul>
  </div>
</div>
<style>
  .seo-requests{min-width:0;padding-block:1.5rem}
  .requests-heading{color:var(--plate);font-size:.9rem;font-weight:650;margin-bottom:1.25rem}
  .requests-viewport{--row-height:9rem;height:calc(var(--row-height)*2);overflow:hidden;mask-image:linear-gradient(to bottom,transparent,#000 16%,#000 84%,transparent);-webkit-mask-image:linear-gradient(to bottom,transparent,#000 16%,#000 84%,transparent)}
  .requests-track{list-style:none;padding:0;margin:0;animation:requests-rise 32s linear infinite;will-change:transform}
  .request{height:var(--row-height);display:flex;align-items:center;padding:1.2rem .65rem 1.2rem 0;color:var(--ink);font-size:clamp(1.15rem,2vw,1.45rem);font-weight:550;line-height:1.5;letter-spacing:-.025em}
  .seo-requests:hover .requests-track{animation-play-state:paused}
  @keyframes requests-rise{
    0%,15%{transform:translateY(0)}
    20%,35%{transform:translateY(calc(var(--row-height)*-1))}
    40%,55%{transform:translateY(calc(var(--row-height)*-2))}
    60%,75%{transform:translateY(calc(var(--row-height)*-3))}
    80%,95%{transform:translateY(calc(var(--row-height)*-4))}
    100%{transform:translateY(calc(var(--row-height)*-5))}
  }
  @media(max-width:36rem){.requests-viewport{--row-height:8.5rem}.request{font-size:1.1rem}}
  @media(prefers-reduced-motion:reduce){
    .requests-viewport{height:auto;overflow:visible;mask-image:none;-webkit-mask-image:none}
    .requests-track{animation:none;will-change:auto}
    .request{height:auto;min-height:5rem;padding-block:.7rem}
    .request[aria-hidden="true"]{display:none}
  }
</style>
