---
const pageSettings = [
  { label: 'Page title', value: 'Services', updated: 'Sleep Medicine Services', kind: 'typing' },
  { label: 'Description', value: 'Learn more about our services', updated: 'Sleep testing and treatment in Arizona', kind: 'typing' },
  { label: 'Indexation', options: ['Yes', 'No', 'Sitemap only'], kind: 'options' },
  { label: 'Canonical URL', value: 'Not set', updated: '/sleep-medicine/', kind: 'typing' },
  { label: 'Schema markup', value: '{"@context":"https://schema.org","@type":"Organization","name":"Example Medical Practice","url":"https://example.com"}', updated: '{"@context":"https://schema.org","@type":"MedicalClinic","name":"Example Medical Practice"}', code: true, kind: 'typing' },
];
const siteCapabilities = [
  'Sitewide indexation controls',
  'XML sitemap management',
  '301 redirects',
  '404 monitoring and reports',
  'SEO configuration checks',
];
---
<section class="hero wrap">
  <div class="hero-layout">
    <div class="hero-copy">
      <h1>Free SEO Settings Tools</h1>
      <p class="hero-subtitle">Control how search engines and AI see your website</p>
      <p class="lede">
        Bare Bones SEO makes it easy to manage page titles, descriptions, indexing, sitemaps, and other technical settings. Free tools for WordPress and AI-built websites—without content scores or bloated software.
      </p>
      <div class="actions" aria-label="Choose a free Bare Bones SEO tool">
        <a class="button" href="/ai-sites/">For AI-built websites</a>
        <a class="button" href="/wordpress/">For WordPress</a>
      </div>
    </div>
    <div class="settings-example" data-settings-demo aria-label="Illustrative page-level SEO editing demo and sitewide capabilities checklist">
      <div class="example-header">
        <p class="example-heading">What Bare Bones SEO helps you manage</p>
        <span class="demo-tag">EXAMPLE</span>
      </div>
      <div class="demo-tabs" role="tablist" aria-label="SEO setting scope">
        <button type="button" class="demo-tab is-selected" role="tab" id="page-tab" data-demo-tab="page" aria-controls="page-panel" aria-selected="true">Page settings</button>
        <button type="button" class="demo-tab" role="tab" id="site-tab" data-demo-tab="site" aria-controls="site-panel" aria-selected="false">Site settings</button>
      </div>
      <div class="demo-panel" id="page-panel" role="tabpanel" aria-labelledby="page-tab" data-demo-panel="page">
        <p class="panel-context">/sleep-medicine/</p>
        <dl class="settings-list">
          {pageSettings.map(({label,value,updated,code,options,kind}) => (
            <div class:list={['setting', {'schema-setting': code}]} data-setting-row data-kind={kind}>
              <dt>{label}</dt>
              <dd>
                {options ? (
                  <span class="index-options" aria-label="Example indexation choices">
                    {options.map((option, i) => <span class:list={['index-option', { selected: i === 0 }]} data-index-option>{option}</span>)}
                  </span>
                ) : (
                  <span class:list={['setting-value', { 'schema-preview': code }]} data-setting-value data-initial={value} data-updated={updated} title={code ? value : undefined}>{value}</span>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="demo-panel" id="site-panel" role="tabpanel" aria-labelledby="site-tab" data-demo-panel="site" hidden>
        <p class="panel-context">Sitewide SEO capabilities</p>
        <ul class="site-capabilities">
          {siteCapabilities.map(item => (
            <li><span class="capability-check" aria-hidden="true">✓</span><span>{item}</span></li>
          ))}
        </ul>
      </div>
      <p class="example-note">Illustrative settings—not a live site report.</p>
    </div>
  </div>
</section>

<script>
  const demo = document.querySelector<HTMLElement>('[data-settings-demo]');
  if (demo) {
    const tabs = Array.from(demo.querySelectorAll<HTMLButtonElement>('[data-demo-tab]'));
    const panels = Array.from(demo.querySelectorAll<HTMLElement>('[data-demo-panel]'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current: 'page' | 'site' = 'page';
    let generation = 0;
    let nextTimer: number | undefined;

    const delay = (ms: number) => new Promise<void>(resolve => { nextTimer = window.setTimeout(resolve, ms); });
    const stillCurrent = (token: number) => token === generation && !document.hidden;
    const activate = (scope: 'page' | 'site') => {
      current = scope;
      generation++;
      panels.forEach(panel => {
        const visible = panel.dataset.demoPanel === scope;
        panel.hidden = !visible;
        panel.querySelectorAll<HTMLElement>('[data-setting-row]').forEach(row => {
          row.classList.remove('is-editing', 'is-updated');
          const value = row.querySelector<HTMLElement>('[data-setting-value]');
          if (value) { value.textContent = value.dataset.initial || ''; value.classList.remove('is-typing'); }
          row.querySelectorAll<HTMLElement>('[data-index-option]').forEach((option, i) => option.classList.toggle('selected', i === 0));
        });
      });
      tabs.forEach(tab => {
        const selected = tab.dataset.demoTab === scope;
        tab.classList.toggle('is-selected', selected);
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
    };
    const select = (scope: 'page' | 'site') => {
      activate(scope);
      if (!reduceMotion) void play(generation);
    };
    async function play(token: number) {
      const panel = demo!.querySelector<HTMLElement>(`[data-demo-panel="${current}"]`);
      if (!panel || !stillCurrent(token)) return;
      if (current === 'site') {
        await delay(4800);
        if (stillCurrent(token)) select('page');
        return;
      }
      const rows = Array.from(panel.querySelectorAll<HTMLElement>('[data-setting-row]'));
      await delay(600);
      for (const row of rows) {
        if (!stillCurrent(token)) return;
        rows.forEach(r => r.classList.remove('is-editing'));
        row.classList.add('is-editing');
        const kind = row.dataset.kind;
        if (kind === 'options') {
          const choices = Array.from(row.querySelectorAll<HTMLElement>('[data-index-option]'));
          for (const choice of [1, 2, 0]) {
            choices.forEach((opt, i) => opt.classList.toggle('selected', i === choice));
            await delay(650);
            if (!stillCurrent(token)) return;
          }
        } else if (kind === 'typing') {
          const value = row.querySelector<HTMLElement>('[data-setting-value]');
          if (value) {
            const before = value.dataset.initial || '';
            const after = value.dataset.updated || '';
            value.classList.add('is-typing');
            for (let i = before.length; i >= 0; i -= 4) {
              value.textContent = before.slice(0, i);
              await delay(38);
              if (!stillCurrent(token)) return;
            }
            for (let i = 2; i <= after.length; i += 2) {
              value.textContent = after.slice(0, i);
              await delay(52);
              if (!stillCurrent(token)) return;
            }
            value.textContent = after;
            value.classList.remove('is-typing');
          }
        } else {
          await delay(650);
        }
        if (!stillCurrent(token)) return;
        row.classList.add('is-updated');
        await delay(620);
      }
      rows.forEach(row => row.classList.remove('is-editing'));
      await delay(2400);
      if (stillCurrent(token)) select(current === 'page' ? 'site' : 'page');
    }
    tabs.forEach(tab => {
      tab.addEventListener('click', () => select(tab.dataset.demoTab as 'page' | 'site'));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const other = tabs.find(candidate => candidate !== tab);
        other?.focus();
        if (other) select(other.dataset.demoTab as 'page' | 'site');
      });
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) generation++;
      else if (!reduceMotion) select(current);
    });
    if (!reduceMotion) void play(generation);
  }
</script>

<style>
  .hero{padding-block:clamp(4.5rem,7vw,6rem)}
  .hero-layout{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);align-items:center;gap:clamp(2rem,5vw,4.5rem)}
  .hero-copy{min-width:0}
  h1{font-size:clamp(2.15rem,4.2vw,3.5rem);line-height:1.13;letter-spacing:-.035em;max-width:20ch;font-weight:650}
  .hero-subtitle{margin-top:var(--space-3);max-width:33rem;font-size:clamp(1.3rem,2.4vw,1.75rem);line-height:1.35;font-weight:600;letter-spacing:-.02em;color:var(--ink)}
  .lede{margin-top:var(--space-2);max-width:34rem;font-size:clamp(1.05rem,1.7vw,1.15rem);line-height:1.65;color:var(--ink-soft)}
  .actions{margin-top:var(--space-4);display:flex;flex-wrap:wrap;align-items:center;gap:.75rem}
  .button{display:inline-block;padding:.85rem 1.25rem;background:var(--plate);color:var(--action-ink);text-decoration:none;font-weight:680;font-size:.92rem;border:1px solid var(--plate);border-radius:7px}
  .button:hover{color:var(--action-ink);background:#ffe29b;border-color:#ffe29b}
  .settings-example{min-width:0;border:1px solid var(--line);border-radius:10px;background:var(--surface);padding:clamp(1.2rem,2.6vw,2rem)}
  .example-header{display:flex;align-items:center;justify-content:space-between;gap:.7rem;margin-bottom:.85rem}
  .example-heading{font-size:.92rem;font-weight:700;color:var(--ink);line-height:1.45}
  .demo-tag{font-size:.65rem;letter-spacing:.08em;color:var(--plate);font-weight:750}
  .demo-tabs{display:grid;grid-template-columns:1fr 1fr;gap:.35rem;padding:.2rem;background:#142032;border-radius:8px;margin-bottom:.9rem}
  .demo-tab{border:0;border-radius:6px;color:var(--ink-soft);background:transparent;padding:.58rem .35rem;font-size:.78rem;font-weight:700;cursor:pointer}
  .demo-tab.is-selected{background:#394d65;color:var(--plate);box-shadow:0 1px 3px #0003}
  .demo-panel[hidden]{display:none}
  .panel-context{font:.75rem/1.5 var(--mono);color:#b9c8db;margin-bottom:.45rem}
  .settings-list{margin:0;padding:0}
  .site-capabilities{list-style:none;padding:.3rem 0;margin:0;display:grid;gap:.25rem}
  .site-capabilities li{display:flex;align-items:center;gap:.8rem;padding:.8rem .35rem;border-bottom:1px solid var(--line);font-size:.9rem;color:var(--ink-soft)}
  .site-capabilities li:last-child{border:0}
  .capability-check{flex:none;display:grid;place-items:center;background:#354b65;color:var(--plate);border-radius:50%;width:1.4rem;height:1.4rem;font-weight:800}
  .schema-setting{grid-template-columns:minmax(0,1fr);gap:.4rem;padding-block:1rem}
  .schema-setting dd{padding:.65rem .75rem;background:#142032;border:1px solid #43576e;border-radius:6px;min-height:4.2rem}
  .schema-preview{display:block;width:100%;white-space:normal;overflow-wrap:anywhere;font:400 .73rem/1.6 var(--mono);max-height:6.5rem;overflow:hidden}
  .setting{display:grid;grid-template-columns:minmax(6.6rem,.7fr) minmax(0,1.3fr);gap:.6rem;align-items:baseline;padding:.55rem .45rem;margin-inline:-.45rem;border-bottom:1px solid var(--line);border-radius:5px;transition:background-color .25s ease,box-shadow .25s ease}
  .setting:last-child{border-bottom:0}
  .setting.is-editing{background:#33445b;box-shadow:inset 3px 0 var(--plate)}
  .setting.is-updated dt{color:#f2d68e}
  .setting dt{color:var(--ink-soft);font-size:.82rem}
  .setting dd{margin:0;min-width:0;color:var(--ink);font-size:.85rem;font-weight:600;overflow-wrap:anywhere}
  .setting-value.is-typing::after{content:' ';display:inline-block;height:1em;border-right:2px solid var(--plate);margin-left:2px;vertical-align:-.15em}
  .index-options{display:flex;flex-wrap:nowrap;gap:.25rem;white-space:nowrap}
  .index-option{border:1px solid #64758a;border-radius:4px;padding:.13rem .32rem;font-size:.68rem;color:var(--ink-soft);font-weight:550;transition:background-color .2s,border-color .2s,color .2s}
  .index-option.selected{background:var(--plate);color:#111827;border-color:var(--plate);font-weight:750}
  .example-note{margin-top:1rem;color:var(--ink-soft);font-size:.75rem;line-height:1.5}
  @media(max-width:53rem){.hero-layout{grid-template-columns:1fr;gap:2.5rem}.settings-example{max-width:38rem}}
  @media(max-width:31rem){.index-options{gap:.15rem}.index-option{font-size:.62rem;padding:.12rem .2rem}.setting:not(.schema-setting){grid-template-columns:minmax(6.1rem,.85fr) minmax(0,1.15fr);gap:.4rem}}
  @media(prefers-reduced-motion:reduce){.setting,.index-option{transition:none}}
</style>
