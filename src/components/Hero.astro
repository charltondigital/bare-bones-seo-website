---
import { site } from '../data/site.js';
import Skull from './Skull.astro';
---
<section class="hero wrap">
  <div class="hero-title-row">
    <h1><span class="heading-mark"><Skull size={48} /></span>{site.tagline}</h1>
    <div class="platform-logos" aria-label="WordPress and static site builders">
      <span class="platform" title="WordPress"><img src="https://cdn.simpleicons.org/wordpress/55ACEE" alt="WordPress" width="40" height="40" loading="lazy" /></span>
      <span class="platform" title="Astro"><img src="https://cdn.simpleicons.org/astro/FF5D01" alt="Astro" width="40" height="40" loading="lazy" /></span>
      <span class="platform" title="Hugo"><img src="https://cdn.simpleicons.org/hugo/FF4088" alt="Hugo" width="40" height="40" loading="lazy" /></span>
      <span class="platform" title="Eleventy"><img src="https://cdn.simpleicons.org/eleventy/FFFFFF" alt="Eleventy" width="40" height="40" loading="lazy" /></span>
    </div>
  </div>
  <p class="lede">
    Give site owners and SEOs the visibility, control, and consistency they deserve. Our free, open-source tools make technical SEO easier to manage—whether you build websites with AI or WordPress. Less busywork, fewer surprises, and no bloated software.
  </p>
  <div class="actions" aria-label="Choose a free Bare Bones SEO tool">
    <a class="button" href="/ai-sites/">For AI-built websites</a>
    <a class="button" href="/wordpress/">For WordPress</a>
  </div>
</section>

<style>
  .heading-mark{display:inline-flex;vertical-align:-.035em;margin-right:.2em;line-height:1}
  .heading-mark :global(svg){display:block;width:.82em;height:.82em}

  .hero { padding-block: clamp(4rem, 7vw, 6rem) clamp(4rem, 7vw, 6rem); }
  .hero-title-row{display:flex;justify-content:space-between;gap:clamp(1.5rem,5vw,4rem);align-items:center}
  .hero-title-row h1{min-width:0}
  .platform-logos{display:flex;gap:.7rem;align-items:center;flex:none}
  .platform{width:3.8rem;height:3.8rem;display:grid;place-items:center;border:1px solid var(--line);background:var(--surface);border-radius:10px}
  .platform img{display:block;width:2.35rem;height:2.35rem;object-fit:contain}
  @media(max-width:58rem){.hero-title-row{align-items:flex-start;flex-direction:column;gap:1.75rem}}
  @media(max-width:30rem){.platform-logos{gap:.45rem}.platform{width:3rem;height:3rem}.platform img{width:1.9rem;height:1.9rem}}
  h1 { font-size: clamp(2.15rem, 4.4vw, 3.6rem); line-height: 1.13; letter-spacing: -.035em; max-width: 23ch; font-weight: 650; }
  .lede { margin-top: var(--space-3); max-width: 43rem; font-size: clamp(1.05rem, 1.8vw, 1.2rem); line-height: 1.65; color: var(--ink-soft); }
  .actions { margin-top: var(--space-4); display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; }
  .button { display: inline-block; padding: .85rem 1.25rem; background: var(--plate); color: var(--action-ink); text-decoration: none; font-weight: 680; font-size: .92rem; border: 1px solid var(--plate); border-radius: 7px; }
  .button:hover { color: var(--action-ink); background: #ffe29b; border-color: #ffe29b; }
</style>
