---
import { site } from '../data/site.js';
import Skull from './Skull.astro';
---
<section class="hero wrap">
  <h1><span class="heading-mark"><Skull size={48} /></span>{site.tagline}</h1>
  <p class="lede">
    Just the essentials to manage titles, indexation, redirects, and other technical SEO settings. A free WordPress plugin and open-source standards for AI-generated static sites.
  </p>
  <div class="actions" aria-label="Choose your Bare Bones SEO option">
    <a class="button" href="/wordpress/">WordPress plugin</a>
    <a class="button secondary" href="/ai-sites/">SEO for AI-built sites</a>
  </div>
</section>

<style>
  .heading-mark{display:inline-flex;vertical-align:-.035em;margin-right:.2em;line-height:1}
  .heading-mark :global(svg){display:block;width:.82em;height:.82em}

  .hero { padding-block: var(--space-5) var(--space-6); }
  h1 { font-size: clamp(2.5rem, 6.5vw, 5.2rem); line-height: .98; letter-spacing: -.025em; max-width: 18ch; }
  .lede { margin-top: var(--space-4); max-width: 44rem; font-size: 1.2rem; color: var(--ink-soft); }
  .actions { margin-top: var(--space-4); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }
  .button { display: inline-block; padding: .75rem 1.2rem; background: var(--ink); color: var(--paper); text-decoration: none; font-weight: 600; border: 1px solid var(--ink); border-radius: 3px; }
  .button:hover { background: var(--plate); border-color: var(--plate); }
  .button.secondary { background: transparent; color: var(--ink); }
  .button.secondary:hover { color: var(--paper); background: var(--ink); }
</style>
