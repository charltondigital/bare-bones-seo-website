---
const settings = [
  { label: 'Page title', value: 'Services', updated: 'Sleep Medicine Services' },
  { label: 'Description', value: 'Learn more about our services', updated: 'Sleep testing and treatment' },
  { label: 'Search indexing', value: 'Review', updated: 'Allowed', good: true },
  { label: 'Sitemap', value: 'Review', updated: 'Included', good: true },
  { label: 'Canonical URL', value: 'Not set', updated: '/sleep-medicine/' },
  { label: 'Schema markup', value: 'Not set', updated: '{"@context":"https://schema.org","@type":"Organization","name":"Example Medical Practice","url":"https://example.com"}', code: true },
  { label: '301 redirects', value: 'None', updated: '/sleep-clinic/ → /sleep-medicine/' },
  { label: '404 logging', value: 'Off', updated: 'Broken URLs tracked' },
];
---
<section class="hero wrap">
  <div class="hero-layout">
    <div class="hero-copy">
      <h1>Free SEO Settings Tools</h1>
      <p class="hero-subtitle">Control how search engines and AI see your website</p>
      <p class="lede">
        Bare Bones SEO makes it easy to manage page titles, descriptions, indexing, sitemaps, and other technical settings. Free tools for WordPress and AI-built websites—without content scores or bloated software.
      </p>
      <div class="actions" aria-label="Choose a free Bare Bones SEO tool">
        <a class="button" href="/ai-sites/">For AI-built websites</a>
        <a class="button" href="/wordpress/">For WordPress</a>
      </div>
    </div>
    <div class="settings-example" data-settings-demo aria-label="Animated illustration of example technical SEO settings being reviewed and updated">
      <p class="example-heading">What Bare Bones SEO helps you manage</p>
      <dl class="settings-list">
        {settings.map(({label,value,updated,good,code}) => (
          <div class="setting" data-setting-row>
            <dt>{label}</dt>
            <dd><span class:list={[{ "schema-preview": code }]} data-setting-value data-initial={value} data-updated={updated} title={code ? updated : undefined}>{value}</span>{good && <span class="check" aria-hidden="true" hidden>✓</span>}</dd>
          </div>
        ))}
      </dl>
      <p class="example-note">Illustrative walkthrough—not a live site report.</p>
    </div>
  </div>
</section>

<script>
  const demo = document.querySelector<HTMLElement>('[data-settings-demo]');
  if (demo && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const rows = Array.from(demo.querySelectorAll<HTMLElement>('[data-setting-row]'));
    let index = 0;
    let timer: number | undefined;
    const reset = () => {
      rows.forEach((row) => {
        row.classList.remove('is-editing', 'is-updated');
        const value = row.querySelector<HTMLElement>('[data-setting-value]');
        if (value) value.textContent = value.dataset.initial || '';
        const check = row.querySelector<HTMLElement>('.check');
        if (check) check.hidden = true;
      });
      index = 0;
    };
    const advance = () => {
      rows.forEach((row) => row.classList.remove('is-editing'));
      if (index >= rows.length) {
        timer = window.setTimeout(() => { reset(); schedule(); }, 2200);
        return;
      }
      const row = rows[index++];
      row.classList.add('is-editing');
      timer = window.setTimeout(() => {
        const value = row.querySelector<HTMLElement>('[data-setting-value]');
        if (value) value.textContent = value.dataset.updated || '';
        const check = row.querySelector<HTMLElement>('.check');
        if (check) check.hidden = false;
        row.classList.add('is-updated');
        timer = window.setTimeout(advance, 650);
      }, 800);
    };
    const schedule = () => { timer = window.setTimeout(advance, 850); };
    const stop = () => { if (timer !== undefined) window.clearTimeout(timer); timer = undefined; };
    const resume = () => { if (!document.hidden && !demo.matches(':hover') && timer === undefined) schedule(); };
    demo.addEventListener('mouseenter', stop);
    demo.addEventListener('mouseleave', resume);
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else resume(); });
    schedule();
  }
</script>

<style>
  .hero{padding-block:clamp(4.5rem,7vw,6rem)}
  .hero-layout{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);align-items:center;gap:clamp(2rem,5vw,4.5rem)}
  .hero-copy{min-width:0}
  h1{font-size:clamp(2.15rem,4.2vw,3.5rem);line-height:1.13;letter-spacing:-.035em;max-width:20ch;font-weight:650}
  .hero-subtitle{margin-top:var(--space-3);max-width:33rem;font-size:clamp(1.3rem,2.4vw,1.75rem);line-height:1.35;font-weight:600;letter-spacing:-.02em;color:var(--ink)}
  .lede{margin-top:var(--space-2);max-width:34rem;font-size:clamp(1.05rem,1.7vw,1.15rem);line-height:1.65;color:var(--ink-soft)}
  .actions{margin-top:var(--space-4);display:flex;flex-wrap:wrap;align-items:center;gap:.75rem}
  .button{display:inline-block;padding:.85rem 1.25rem;background:var(--plate);color:var(--action-ink);text-decoration:none;font-weight:680;font-size:.92rem;border:1px solid var(--plate);border-radius:7px}
  .button:hover{color:var(--action-ink);background:#ffe29b;border-color:#ffe29b}
  .settings-example{min-width:0;border:1px solid var(--line);border-radius:10px;background:var(--surface);padding:clamp(1.2rem,2.6vw,2rem)}
  .example-heading{font-size:.92rem;font-weight:700;color:var(--ink);line-height:1.45;margin-bottom:.85rem}
  .settings-list{margin:0;padding:0}
  .setting{display:grid;grid-template-columns:minmax(7.5rem,.85fr) minmax(0,1.15fr);gap:1rem;align-items:baseline;padding:.55rem 0;border-bottom:1px solid var(--line)}
  .setting:last-child{border-bottom:0}
  .setting{position:relative;transition:background-color .25s ease,box-shadow .25s ease;padding-inline:.45rem;margin-inline:-.45rem;border-radius:5px}
  .setting.is-editing{background:#33445b;box-shadow:inset 3px 0 var(--plate)}
  .setting.is-updated dt{color:#f2d68e}
  .check[hidden]{display:none}
  @media(prefers-reduced-motion:reduce){.setting{transition:none}}
  .setting dt{color:var(--ink-soft);font-size:.82rem}
  .setting dd{margin:0;color:var(--ink);font-size:.85rem;font-weight:600;overflow-wrap:anywhere}
  .schema-preview{display:block;width:100%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font:inherit;font-family:var(--mono);font-size:.76rem}
  .check{display:inline-block;margin-left:.5rem;color:var(--plate);font-size:.95rem}
  .example-note{margin-top:1rem;color:var(--ink-soft);font-size:.75rem;line-height:1.5}
  @media(max-width:53rem){.hero-layout{grid-template-columns:1fr;gap:2.5rem}.settings-example{max-width:38rem}}
  @media(max-width:30rem){.setting{grid-template-columns:minmax(6.3rem,.85fr) minmax(0,1.15fr);gap:.55rem}}
</style>
