---
import { site } from '../data/site.js';
---
<section class="hero wrap">
  <h1>{site.tagline}</h1>
  <p class="lede">
    Most of what moves rankings happens outside a plugin. Bare Bones SEO handles the handful of settings that
    belong inside one, then stays out of your way.
  </p>
  <div class="actions">
    {site.wporg
      ? <a class="button" href={site.wporg}>Get it on WordPress.org</a>
      : <a class="button" href={site.github}>View the source on GitHub</a>}
    <p class="status">
      {site.wporg ? 'Free and open source.' : 'Version 1.0 is in review for the WordPress.org plugin directory.'}
    </p>
  </div>
</section>

<style>
  .hero { padding-block: var(--space-5) var(--space-6); }
  h1 {
    font-size: clamp(2.9rem, 8.5vw, 6.25rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
    max-width: 11ch;
  }
  .lede { margin-top: var(--space-4); max-width: var(--measure); font-size: 1.2rem; color: var(--ink-soft); }
  .actions { margin-top: var(--space-4); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); }
  .button {
    display: inline-block; padding: 0.75rem 1.2rem; background: var(--ink); color: var(--paper);
    text-decoration: none; font-weight: 600; border-radius: 3px;
  }
  .button:hover { background: var(--plate); }
  .status { font-size: 0.95rem; color: var(--ink-soft); }
</style>
