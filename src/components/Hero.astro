---
import Skull from './Skull.astro';
const settings = [
  { label: 'Page title', value: 'Sleep Medicine Services' },
  { label: 'Description', value: 'Sleep testing and treatment' },
  { label: 'Search indexing', value: 'Allowed', good: true },
  { label: 'Sitemap', value: 'Included', good: true },
  { label: 'Canonical URL', value: '/sleep-medicine/' },
];
---
<section class="hero wrap">
  <div class="hero-layout">
    <div class="hero-copy">
      <h1><span class="heading-mark"><Skull size={48} /></span>Control what search engines see on your website.</h1>
      <p class="lede">
        Bare Bones SEO makes it easy to manage page titles, descriptions, indexing, sitemaps, and other technical settings. Free tools for WordPress and AI-built websites—without content scores or bloated software.
      </p>
      <div class="actions" aria-label="Choose a free Bare Bones SEO tool">
        <a class="button" href="/ai-sites/">For AI-built websites</a>
        <a class="button" href="/wordpress/">For WordPress</a>
      </div>
    </div>
    <div class="settings-example" aria-label="Illustration of the SEO settings your website sends to search engines">
      <p class="example-heading">What your website tells search engines</p>
      <dl class="settings-list">
        {settings.map(({label,value,good}) => (
          <div class="setting">
            <dt>{label}</dt>
            <dd>{value}{good && <span class="check" aria-label="Enabled">✓</span>}</dd>
          </div>
        ))}
      </dl>
      <p class="example-note">Example settings—not a live site report.</p>
    </div>
  </div>
</section>

<style>
  .heading-mark{display:inline-flex;vertical-align:-.035em;margin-right:.2em;line-height:1}
  .heading-mark :global(svg){display:block;width:.82em;height:.82em}
  .hero{padding-block:clamp(3.5rem,6vw,5.25rem)}
  .hero-layout{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);align-items:center;gap:clamp(2rem,5vw,4.5rem)}
  .hero-copy{min-width:0}
  h1{font-size:clamp(2.15rem,4.2vw,3.5rem);line-height:1.13;letter-spacing:-.035em;max-width:20ch;font-weight:650}
  .lede{margin-top:var(--space-3);max-width:34rem;font-size:clamp(1.05rem,1.7vw,1.15rem);line-height:1.65;color:var(--ink-soft)}
  .actions{margin-top:var(--space-4);display:flex;flex-wrap:wrap;align-items:center;gap:.75rem}
  .button{display:inline-block;padding:.85rem 1.25rem;background:var(--plate);color:var(--action-ink);text-decoration:none;font-weight:680;font-size:.92rem;border:1px solid var(--plate);border-radius:7px}
  .button:hover{color:var(--action-ink);background:#ffe29b;border-color:#ffe29b}
  .settings-example{min-width:0;border:1px solid var(--line);border-radius:10px;background:var(--surface);padding:clamp(1.2rem,2.6vw,2rem)}
  .example-heading{font-size:.92rem;font-weight:700;color:var(--ink);line-height:1.45;margin-bottom:1.2rem}
  .settings-list{margin:0;padding:0}
  .setting{display:grid;grid-template-columns:minmax(7.5rem,.85fr) minmax(0,1.15fr);gap:1rem;align-items:baseline;padding:.75rem 0;border-bottom:1px solid var(--line)}
  .setting:last-child{border-bottom:0}
  .setting dt{color:var(--ink-soft);font-size:.82rem}
  .setting dd{margin:0;color:var(--ink);font-size:.85rem;font-weight:600;overflow-wrap:anywhere}
  .check{display:inline-block;margin-left:.5rem;color:var(--plate);font-size:.95rem}
  .example-note{margin-top:1rem;color:var(--ink-soft);font-size:.75rem;line-height:1.5}
  @media(max-width:53rem){.hero-layout{grid-template-columns:1fr;gap:2.5rem}.settings-example{max-width:38rem}}
  @media(max-width:30rem){.setting{grid-template-columns:minmax(6.3rem,.85fr) minmax(0,1.15fr);gap:.55rem}}
</style>
