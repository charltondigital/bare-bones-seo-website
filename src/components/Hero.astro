---
const settings = [
  { label: 'Page title', value: 'Services', updated: 'Sleep Medicine Services', kind: 'typing' },
  { label: 'Description', value: 'Learn more about our services', updated: 'Sleep testing and treatment in Arizona', kind: 'typing' },
  { label: 'Indexation', options: ['Yes', 'No', 'Sitemap only'], kind: 'options' },
  { label: 'Canonical URL', value: 'Not set', updated: '/sleep-medicine/', kind: 'typing' },
  { label: 'Schema markup', value: '{"@context":"https://schema.org","@type":"Organization","name":"Example Medical Practice","url":"https://example.com"}', updated: '{"@context":"https://schema.org","@type":"MedicalClinic","name":"Example Medical Practice"}', code: true, kind: 'typing' },
  { label: '301 redirects', value: '/old-services/ → /services/', updated: '/sleep-clinic/ → /sleep-medicine/', kind: 'typing' },
  { label: '404 monitor', value: 'View missing URLs', kind: '404' },
];
const missingUrls = [
  { url: '/sleep-clinic/', hits: 42, last: 'Nov 18, 2026' },
  { url: '/old-contact/', hits: 17, last: 'Nov 17, 2026' },
  { url: '/sleep-test/', hits: 8, last: 'Nov 16, 2026' },
];
---
<section class="hero wrap">
  <div class="hero-layout">
    <div class="hero-copy">
      <h1>Free SEO Settings Tools</h1>
      <p class="hero-subtitle">Control how search engines and AI see your website</p>
      <p class="lede">
        Bare Bones SEO makes it easy to manage page titles, descriptions, indexing, sitemaps, and other technical settings. Free tools for WordPress and AI-built websites—without content scores or bloated software.
      </p>
      <div class="actions" aria-label="Choose a free Bare Bones SEO tool">
        <a class="button" href="/ai-sites/">For AI-built websites</a>
        <a class="button" href="/wordpress/">For WordPress</a>
      </div>
    </div>
    <div class="settings-example" data-settings-demo aria-label="Illustrative animation of SEO settings being edited and a sample 404 report">
      <div class="example-header">
        <p class="example-heading">What Bare Bones SEO helps you manage</p>
        <span class="demo-tag">EXAMPLE</span>
      </div>
      <dl class="settings-list">
        {settings.map(({label,value,updated,code,options,kind}) => (
          <div class="setting" data-setting-row data-kind={kind}>
            <dt>{label}</dt>
            <dd>
              {options ? (
                <span class="index-options" aria-label="Example indexation modes">
                  {options.map((option, i) => <span class:list={['index-option', { selected: i === 0 }]} data-index-option>{option}</span>)}
                </span>
              ) : (
                <span class:list={['setting-value', { 'schema-preview': code }]} data-setting-value data-initial={value} data-updated={updated} title={code ? value : undefined}>{value}</span>
              )}
            </dd>
          </div>
        ))}
      </dl>
      <div class="missing-report" data-missing-report aria-hidden="true">
        <div class="report-heading"><span>Recent 404 requests</span><span>Last seen</span></div>
        {missingUrls.map(({url,hits,last}) => (
          <div class="missing-entry" data-missing-entry>
            <div class="missing-path"><code>{url}</code><small>{hits} hits</small></div>
            <time>{last}</time>
          </div>
        ))}
      </div>
      <p class="example-note">Sample settings and fictitious request logs—not live site data.</p>
    </div>
  </div>
</section>

<script>
  const demo = document.querySelector<HTMLElement>('[data-settings-demo]');
  if (demo && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const rows = Array.from(demo.querySelectorAll<HTMLElement>('[data-setting-row]'));
    const report = demo.querySelector<HTMLElement>('[data-missing-report]');
    const entries = Array.from(demo.querySelectorAll<HTMLElement>('[data-missing-entry]'));
    let cycle = 0;
    let timeout: number | undefined;
    let paused = false;
    const sleep = (ms: number, token: number) => new Promise<boolean>((resolve) => {
      timeout = window.setTimeout(() => { timeout = undefined; resolve(token === cycle && !paused); }, ms);
    });
    const reset = () => {
      rows.forEach((row) => {
        row.classList.remove('is-editing', 'is-updated');
        const value = row.querySelector<HTMLElement>('[data-setting-value]');
        if (value) value.textContent = value.dataset.initial || '';
        row.querySelectorAll<HTMLElement>('[data-index-option]').forEach((option, i) => option.classList.toggle('selected', i === 0));
      });
      report?.classList.remove('is-visible');
      report?.setAttribute('aria-hidden', 'true');
      entries.forEach(entry => entry.classList.remove('is-visible'));
    };
    const typeValue = async (value: HTMLElement, token: number) => {
      const before = value.dataset.initial || '';
      const after = value.dataset.updated || '';
      // Show a real edit rather than instantly swapping all of the text.
      value.classList.add('is-typing');
      for (let i = before.length; i >= 0; i -= 3) {
        value.textContent = before.slice(0, i);
        if (!(await sleep(22, token))) return false;
      }
      for (let i = 1; i <= after.length; i += 2) {
        value.textContent = after.slice(0, i);
        if (!(await sleep(30, token))) return false;
      }
      value.textContent = after;
      value.classList.remove('is-typing');
      return true;
    };
    const play = async (token: number) => {
      reset();
      if (!(await sleep(350, token))) return;
      for (const row of rows) {
        if (token !== cycle || paused) return;
        rows.forEach(item => item.classList.remove('is-editing'));
        row.classList.add('is-editing');
        const kind = row.dataset.kind;
        if (kind === 'options') {
          const options = Array.from(row.querySelectorAll<HTMLElement>('[data-index-option]'));
          for (const choice of [1, 2, 0]) {
            options.forEach((option, i) => option.classList.toggle('selected', i === choice));
            if (!(await sleep(490, token))) return;
          }
        } else if (kind === '404') {
          report?.classList.add('is-visible');
          report?.setAttribute('aria-hidden', 'false');
          for (const entry of entries) {
            entry.classList.add('is-visible');
            if (!(await sleep(500, token))) return;
          }
          if (!(await sleep(1500, token))) return;
        } else {
          const value = row.querySelector<HTMLElement>('[data-setting-value]');
          if (value && !(await typeValue(value, token))) return;
          if (!(await sleep(420, token))) return;
        }
        row.classList.add('is-updated');
      }
      rows.forEach(row => row.classList.remove('is-editing'));
      if (!(await sleep(2600, token))) return;
      if (token === cycle && !paused) { cycle++; void play(cycle); }
    };
    const stop = () => {
      paused = true;
      cycle++;
      if (timeout !== undefined) window.clearTimeout(timeout);
      timeout = undefined;
      demo.querySelectorAll('.is-typing').forEach(el => el.classList.remove('is-typing'));
    };
    const resume = () => {
      if (!document.hidden && !demo.matches(':hover') && paused) {
        paused = false;
        cycle++;
        void play(cycle);
      }
    };
    demo.addEventListener('mouseenter', stop);
    demo.addEventListener('mouseleave', resume);
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else resume(); });
    void play(cycle);
  }
</script>

<style>
  .hero{padding-block:clamp(4.5rem,7vw,6rem)}
  .hero-layout{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);align-items:center;gap:clamp(2rem,5vw,4.5rem)}
  .hero-copy{min-width:0}
  h1{font-size:clamp(2.15rem,4.2vw,3.5rem);line-height:1.13;letter-spacing:-.035em;max-width:20ch;font-weight:650}
  .hero-subtitle{margin-top:var(--space-3);max-width:33rem;font-size:clamp(1.3rem,2.4vw,1.75rem);line-height:1.35;font-weight:600;letter-spacing:-.02em;color:var(--ink)}
  .lede{margin-top:var(--space-2);max-width:34rem;font-size:clamp(1.05rem,1.7vw,1.15rem);line-height:1.65;color:var(--ink-soft)}
  .actions{margin-top:var(--space-4);display:flex;flex-wrap:wrap;align-items:center;gap:.75rem}
  .button{display:inline-block;padding:.85rem 1.25rem;background:var(--plate);color:var(--action-ink);text-decoration:none;font-weight:680;font-size:.92rem;border:1px solid var(--plate);border-radius:7px}
  .button:hover{color:var(--action-ink);background:#ffe29b;border-color:#ffe29b}
  .settings-example{min-width:0;border:1px solid var(--line);border-radius:10px;background:var(--surface);padding:clamp(1.2rem,2.6vw,2rem)}
  .example-header{display:flex;align-items:center;justify-content:space-between;gap:.7rem;margin-bottom:.85rem}
  .example-heading{font-size:.92rem;font-weight:700;color:var(--ink);line-height:1.45}
  .demo-tag{font-size:.65rem;letter-spacing:.08em;color:var(--plate);font-weight:750}
  .settings-list{margin:0;padding:0}
  .setting{display:grid;grid-template-columns:minmax(6.6rem,.7fr) minmax(0,1.3fr);gap:.6rem;align-items:baseline;padding:.55rem .45rem;margin-inline:-.45rem;border-bottom:1px solid var(--line);border-radius:5px;transition:background-color .25s ease,box-shadow .25s ease}
  .setting:last-child{border-bottom:0}
  .setting.is-editing{background:#33445b;box-shadow:inset 3px 0 var(--plate)}
  .setting.is-updated dt{color:#f2d68e}
  .setting dt{color:var(--ink-soft);font-size:.82rem}
  .setting dd{margin:0;min-width:0;color:var(--ink);font-size:.85rem;font-weight:600;overflow-wrap:anywhere}
  .setting-value.is-typing::after{content:' ';display:inline-block;height:1em;border-right:2px solid var(--plate);margin-left:2px;vertical-align:-.15em}
  .schema-preview{display:block;width:100%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font:inherit;font-family:var(--mono);font-size:.76rem}
  .index-options{display:flex;flex-wrap:nowrap;gap:.25rem;white-space:nowrap}
  .index-option{border:1px solid #64758a;border-radius:4px;padding:.13rem .32rem;font-size:.68rem;color:var(--ink-soft);font-weight:550;transition:background-color .2s,border-color .2s,color .2s}
  .index-option.selected{background:var(--plate);color:#111827;border-color:var(--plate);font-weight:750}
  .missing-report{max-height:0;overflow:hidden;opacity:0;transition:max-height .35s ease,opacity .3s ease;border-top:0 solid var(--line)}
  .missing-report.is-visible{max-height:16rem;opacity:1;border-top-width:1px;margin-top:.8rem;padding-top:.75rem}
  .report-heading,.missing-entry{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:.7rem;align-items:center}
  .report-heading{font-size:.7rem;color:#b6c4d8;margin-bottom:.35rem;font-weight:700}
  .missing-entry{padding:.43rem .5rem;border-radius:5px;opacity:0;transform:translateY(5px);transition:opacity .25s,transform .25s;font-size:.75rem}
  .missing-entry.is-visible{opacity:1;transform:translateY(0)}
  .missing-entry:nth-of-type(even){background:#2a3d52}
  .missing-path{display:flex;flex-direction:column;min-width:0}
  .missing-path code{font:.77rem/1.3 var(--mono);overflow:hidden;text-overflow:ellipsis}
  .missing-path small{font-size:.7rem;color:var(--plate)}
  .missing-entry time{font-size:.7rem;color:var(--ink-soft)}
  .example-note{margin-top:1rem;color:var(--ink-soft);font-size:.75rem;line-height:1.5}
  @media(max-width:53rem){.hero-layout{grid-template-columns:1fr;gap:2.5rem}.settings-example{max-width:38rem}}
  @media(max-width:31rem){.index-options{gap:.15rem}.index-option{font-size:.62rem;padding:.12rem .2rem}.setting{grid-template-columns:minmax(6.1rem,.85fr) minmax(0,1.15fr);gap:.4rem}}
  @media(prefers-reduced-motion:reduce){.setting,.missing-report,.missing-entry,.index-option{transition:none}.missing-report{max-height:none;opacity:1;margin-top:.8rem;padding-top:.75rem;border-top:1px solid var(--line)}.missing-entry{opacity:1;transform:none}}
</style>
