---
import { site } from '../data/site.js';
import Skull from './Skull.astro';
---
<section class="hero wrap">
  <h1><span class="heading-mark"><Skull size={48} /></span>{site.tagline}</h1>
  <p class="lede">
    Just the essentials to manage titles, indexation, redirects, and other technical SEO settings. A free WordPress plugin and open-source standards for AI-generated static sites.
  </p>
  <div class="actions" aria-label="Choose your Bare Bones SEO option">
    <a class="button" href="/wordpress/">WordPress plugin</a>
    <a class="button secondary" href="/ai-sites/">SEO for AI-built sites</a>
  </div>
</section>

<style>
  .heading-mark{display:inline-flex;vertical-align:-.035em;margin-right:.2em;line-height:1}
  .heading-mark :global(svg){display:block;width:.82em;height:.82em}

  .hero { padding-block: clamp(4rem, 7vw, 6rem) clamp(4rem, 7vw, 6rem); }
  h1 { font-size: clamp(2.75rem, 6.5vw, 5.3rem); line-height: 1.04; letter-spacing: -.065em; max-width: 19ch; font-weight: 790; }
  .lede { margin-top: var(--space-3); max-width: 43rem; font-size: clamp(1.05rem, 1.8vw, 1.2rem); line-height: 1.65; color: var(--ink-soft); }
  .actions { margin-top: var(--space-4); display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; }
  .button { display: inline-block; padding: .85rem 1.25rem; background: var(--plate); color: #fff; text-decoration: none; font-weight: 680; font-size: .92rem; border: 1px solid var(--plate); border-radius: 7px; }
  .button:hover { color: #fff; background: #1949b7; border-color: #1949b7; }
  .button.secondary { background: #fff; color: var(--ink); border-color: var(--line); }
  .button.secondary:hover { color: var(--ink); background: var(--surface); border-color: #b8c4d4; }
</style>
