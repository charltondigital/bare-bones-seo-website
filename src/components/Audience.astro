---
import { site } from '../data/site.js';
---
<section class="section" aria-labelledby="audience-title">
  <div class="wrap narrow">
    <h2 id="audience-title">For developers and SEO practitioners</h2>
    <p>
      Bare Bones SEO is for developers, agencies, and site owners who want to control technical SEO without a pile of extra features. Use the WordPress plugin when working in WordPress, or the static-site standards when an AI agent maintains the site.
    </p>
    <p>
      Both projects are free and open source. Review the <a href={site.github}>WordPress plugin code</a> or the <a href={site.staticGithub}>static-site standards</a> before using them.
    </p>
  </div>
</section>

<style>
  .narrow { max-width: var(--measure); margin-inline: auto; margin-left: max(1.25rem, calc((100% - var(--wide)) / 2)); }
  h2 { font-size: clamp(1.75rem, 3.2vw, 2.4rem); }
  p { margin-top: var(--space-2); color: var(--ink-soft); }
  h2 + p { margin-top: var(--space-3); }
</style>
