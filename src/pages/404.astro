---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Bare Bones SEO">
  <section class="wrap nf">
    <h1>Nothing here.</h1>
    <p>This page doesn't exist. If a link sent you here, the site owner should add a redirect.</p>
    <p><a href="/">Go to the homepage</a></p>
  </section>
</Base>

<style>
  .nf { padding-block: var(--space-6); }
  h1 { font-size: clamp(2.5rem, 7vw, 4.5rem); }
  p { margin-top: var(--space-2); color: var(--ink-soft); max-width: var(--measure); }
</style>
